# Kopiuj do .env (nie commituj .env). Wartości sekretów tylko na serwerze.

# Tryb adapterów: mock | real
HERMES_MODE=mock
STT_MODE=mock

# Hermes (tylko serwer; endpoint dostępny wyłącznie z loopbacka)
HERMES_WS_URL=ws://127.0.0.1:9119/api/ws
HERMES_TOKEN=

# Baza
DATABASE_PATH=./data/app.db

# Dostęp
ALLOWED_EMAIL=sotuldrop@gmail.com

# Worker
WORKER_POLL_MS=1500
# Czas trwania symulowanego zadania Hermesa (tylko HERMES_MODE=mock)
MOCK_HERMES_DURATION_MS=8000
