# Kopiuj do .env (nie commituj .env). Wartości sekretów tylko na serwerze.

# Tryb adapterów: mock | real
HERMES_MODE=mock
STT_MODE=mock
# Stały tekst zwracany przez symulowane STT (tylko STT_MODE=mock)
MOCK_STT_TEXT=Obrób zdjęcia z Zyndrama 20 52

# Hermes (tylko serwer; endpoint dostępny wyłącznie z loopbacka)
HERMES_WS_URL=ws://127.0.0.1:9119/api/ws
HERMES_TOKEN=

# Baza
DATABASE_PATH=./data/app.db

# Dostęp (logowanie)
# google = prawdziwe logowanie Google; dev = logowanie testowe bez Google (tylko lokalnie, nigdy z HERMES_MODE=real)
AUTH_MODE=dev
ALLOWED_EMAIL=sotuldrop@gmail.com
# Co najmniej 32 znaki: openssl rand -base64 48
SESSION_SECRET=
APP_URL=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Worker
WORKER_POLL_MS=1500
# Czas trwania symulowanego zadania Hermesa (tylko HERMES_MODE=mock)
MOCK_HERMES_DURATION_MS=8000
# Healthcheck workera na 127.0.0.1 (opcjonalnie)
WORKER_HEALTH_PORT=
